generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ScreeningDecision {
  RECOMMEND
  HOLD
  REJECT
}

enum ScreeningStatus {
  COMPLETED
  SKIPPED
  FAILED
  PENDING_CONFIG
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  englishName             String                   @db.VarChar(80)
  username                String?                  @unique
  email                   String                   @unique
  passwordHash            String?
  department              String?
  status                  UserStatus               @default(ACTIVE)
  roleId                  String?
  role                    Role?                    @relation(fields: [roleId], references: [id])
  /// OSS 对象 key（如 "avatars/{userId}/{timestamp}.png"）。
  /// 每次 getCurrentUser 用 getSignedUrl 生成 30 天签名 URL 返回给前端。
  avatarObjectKey         String?                  @db.VarChar(500)
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  conversations           ChatConversation[]
  generatedImages         GeneratedImage[]
  imageEditMessages       ImageEditMessage[]
  imagePromptChatSessions ImagePromptChatSession[]
  imagePromptChatMessages ImagePromptChatMessage[]
  chatUsageEvents         ChatUsageEvent[]
  videoGenerations        VideoGeneration[]
  aiUsageLogs             AiUsageLog[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  category    String
  manager     String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("新对话")
  summary   String        @default("")
  pinned    Boolean       @default(false)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  reaction       String?
  // 用户消息附带的图片/文件附件，结构：[{ fileId, name, mime, size, objectKey }]
  attachments    Json?
  /// assistant 消息的 ReAct 工具调用步骤，结构：[{ callId, tool, label, status, detail, args, output }]。
  /// args/output 是截断后的调用参数与观察值，供步骤条展开查看（仅会话本人可见）。
  /// 落库而非只走 SSE：刷新后步骤条要能回放，且「分享给同事」的越权确认要靠它判断
  /// 回答是否引用了具体任务数据（见前端 TASK_REF_TOOLS）。
  toolSteps      Json?
  feedback       ChatFeedback?
  createdAt      DateTime         @default(now())
}

/// 用户对单条 AI 回答的显式反馈。reaction 仍同步保留在 ChatMessage，兼容旧客户端。
model ChatFeedback {
  id             String      @id @default(cuid())
  messageId      String      @unique
  message        ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reaction       String
  reasons        String[]    @default([])
  comment        String      @default("")
  status         String      @default("open")
  resolutionNote String      @default("")
  /// 用户最近一次提交或修改评价的时间；管理端处理状态变化不会改动它。
  submittedAt    DateTime    @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([reaction, createdAt])
  @@index([status, createdAt])
  @@index([submittedAt])
}

/// MateChat 的轻量行为埋点。对话正文不写入 metadata，只记录动作和质量指标。
model ChatUsageEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String
  conversationId String?
  messageId      String?
  model          String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([resource, createdAt, id])
}

model ApiRequestLog {
  id           String   @id @default(cuid())
  requestId    String   @unique
  userId       String?
  method       String
  path         String
  statusCode   Int
  durationMs   Int
  ip           String?
  userAgent    String?
  errorName    String?
  errorMessage String?
  errorStack   String?
  requestMeta  Json     @default("{}")
  responseMeta Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
}

/// MateChat ReAct 写操作的「待确认动作卡」。
/// 曾经整表塞在 SystemSetting 的单个 KV 键里，靠进程内 Map 锁防重复执行——那把锁只在单实例下成立，
/// 且读-改-写整份 JSON 天然有竞态。独立成表后，确认走 `WHERE status='pending'` 的条件更新原子抢占。
model ChatPendingAction {
  id             String   @id
  userId         String
  conversationId String
  /// 关联的 assistant 消息 id（回答落库后回填）；支撑刷新后确认卡按消息恢复
  messageId      String?
  tool           String
  /// 已归一化的执行载荷（确认时直接投给对应服务）
  payload        Json
  /// 推给前端渲染的卡片内容（label/summary/fields/expiresAt）
  card           Json
  /// pending（待确认）→ executing（已抢占，执行中）→ executed；用户取消或过期为 canceled。
  /// executing 是并发抢占的中间态：执行失败会退回 pending，允许用户重试。
  status         String   @default("pending")
  resultMessage  String   @default("")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId, userId, status])
  @@index([status, expiresAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  category    String
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 研发/中美协同任务的上下文讨论线程。
/// 主会话使用 anchorType=task；围绕进度或消息展开的原位讨论分别使用
/// anchorType=progress_note / message。workspace 与 JSON 任务池的命名空间保持一致。
model RdTaskDiscussionThread {
  id           String                        @id
  workspace    String                        @default("rd")
  taskId       String
  anchorType   String                        @default("task")
  anchorId     String?
  messages     RdTaskDiscussionMessage[]
  reads        RdTaskDiscussionRead[]
  participants RdTaskDiscussionParticipant[]
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([workspace, taskId, updatedAt])
  @@index([workspace, taskId, anchorType, anchorId])
}

/// 讨论消息与进度留痕相互独立：聊天可以引用、回复，正式进度/审计仍保持不可变。
model RdTaskDiscussionMessage {
  id         String                    @id @default(cuid())
  threadId   String
  thread     RdTaskDiscussionThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  authorRole String?
  body       String                    @db.Text
  attachments Json                    @default("[]")
  mentions   Json                      @default("[]")
  replyToId  String?
  replyTo    RdTaskDiscussionMessage?  @relation("RdTaskDiscussionReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    RdTaskDiscussionMessage[] @relation("RdTaskDiscussionReplies")
  createdAt  DateTime                  @default(now())
  editedAt   DateTime?

  @@index([threadId, createdAt])
  @@index([replyToId])
}

/// 每位成员在每个线程里的已读游标；打开一个线程不会误清除其他讨论的未读。
model RdTaskDiscussionRead {
  threadId  String
  thread    RdTaskDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  lastReadAt DateTime               @default(now())

  @@id([threadId, userId])
  @@index([userId, lastReadAt])
}

/// 被 @ 的非任务协作者只获得当前线程的临时参与权，不扩大为整项任务的查看或编辑权限。
model RdTaskDiscussionParticipant {
  threadId      String
  thread        RdTaskDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId        String
  invitedById   String?
  invitedByName String
  invitedAt     DateTime               @default(now())
  revokedAt     DateTime?

  @@id([threadId, userId])
  @@index([userId, revokedAt, invitedAt])
}

model PermissionCatalogItem {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String   @default("")
  groupLabel  String
  type        String   @default("page") // page | action
  routePath   String   @default("")
  enabled     Boolean  @default(true)
  /// When true the page is accessible but hidden from the sidebar navigation.
  navHidden   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupLabel, sortOrder])
  @@index([type, enabled])
}

model RuntimeState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OrderProcessingOrder {
  id               String                        @id
  customer         String
  type             String
  status           String
  shipDate         DateTime
  source           String                        @default("upload")
  generated        Boolean                       @default(false)
  invoiceExported  Boolean                       @default(false)
  originalFileName String?
  metadata         Json                          @default("{}")
  products         OrderProcessingOrderProduct[]
  invoice          OrderProcessingInvoice?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([shipDate])
}

model OrderProcessingOrderProduct {
  id         String               @id @default(cuid())
  orderId    String
  order      OrderProcessingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  category   String
  spec       String
  unit       String
  orderQty   Int
  stockQty   Int
  orderPrice Decimal              @db.Decimal(12, 2)
  sysPrice   Decimal              @db.Decimal(12, 2)
  subtotal   Decimal              @db.Decimal(14, 2)
  status     String
  remark     String
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([orderId, sku])
  @@index([sku])
  @@index([status])
}

model OrderProcessingInvoice {
  id          String               @id @default(cuid())
  orderId     String               @unique
  order       OrderProcessingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNo   String               @unique
  amount      Decimal              @db.Decimal(14, 2)
  generatedAt DateTime?
  exportedAt  DateTime?
  templateId  String?
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([generatedAt])
  @@index([exportedAt])
}

model OrderProcessingInventoryItem {
  id              String                         @id
  name            String
  category        String
  spec            String
  stock           Int
  safe            Int
  inboundPending  Int                            @default(0)
  outboundPending Int                            @default(0)
  status          String
  sortOrder       Int                            @default(0)
  movements       OrderProcessingStockMovement[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([sortOrder])
  @@index([category])
  @@index([status])
}

model OrderProcessingStockMovement {
  id             String                       @id
  itemId         String
  item           OrderProcessingInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemName       String
  type           String
  qty            Int
  operator       String
  note           String
  relatedOrderId String?
  documentNo     String?
  warehouse      String?
  supplier       String?
  businessDate   DateTime?
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now())

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([relatedOrderId])
  @@index([businessDate])
}

model OrderProcessingInvoiceTemplate {
  id          String   @id
  name        String
  source      String
  accentColor String?
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, createdAt])
}

model OrderProcessingSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model OrderProcessingInvoiceCounter {
  year      Int      @id
  nextValue Int
  updatedAt DateTime @updatedAt
}

model OrderProcessingPurchaseOrder {
  id              String                             @id @default(cuid())
  poNo            String                             @unique
  supplier        String
  supplierContact String?
  supplierPhone   String?
  supplierEmail   String?
  buyer           String
  status          String
  orderDate       DateTime
  etaDate         DateTime
  itemCount       Int                                @default(0)
  amount          Decimal                            @db.Decimal(14, 2)
  currency        String                             @default("CNY")
  warehouse       String
  owner           String
  paymentTerm     String?
  deliveryTerm    String?
  invoiceType     String?
  approvalStatus  String?
  remark          String?
  sourceFile      String?
  metadata        Json                               @default("{}")
  lines           OrderProcessingPurchaseOrderLine[]
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  @@index([status, etaDate])
  @@index([supplier])
  @@index([orderDate])
  @@index([etaDate])
}

model OrderProcessingPurchaseOrderLine {
  id              String                       @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   OrderProcessingPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku             String
  name            String
  spec            String
  unit            String
  qty             Int
  receivedQty     Int                          @default(0)
  unitPrice       Decimal                      @db.Decimal(12, 2)
  sortOrder       Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([purchaseOrderId, sortOrder])
  @@index([sku])
}

model JobRule {
  id         String               @id @default(cuid())
  name       String
  jdText     String
  enabled    Boolean              @default(true)
  candidates Candidate[]
  screenings CandidateScreening[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model Candidate {
  id                     String               @id @default(cuid())
  uniqueKey              String               @unique
  jobRuleId              String?
  jobRule                JobRule?             @relation(fields: [jobRuleId], references: [id])
  name                   String               @default("")
  email                  String               @default("")
  phone                  String               @default("")
  city                   String               @default("")
  education              String               @default("")
  status                 String               @default("")
  targetJob              String               @default("")
  targetCity             String               @default("")
  salaryExpectation      String               @default("")
  recentCompany          String               @default("")
  recentTitle            String               @default("")
  yearsExperience        String               @default("")
  rawEmailText           String
  parsedCandidateProfile Json
  receivedAt             DateTime
  sourceSubject          String               @default("")
  sourceSenderName       String               @default("")
  sourceSenderEmail      String               @default("")
  screenings             CandidateScreening[]
  ingestionLogs          EmailIngestionLog[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model CandidateScreening {
  id              String             @id @default(cuid())
  candidateId     String
  candidate       Candidate          @relation(fields: [candidateId], references: [id])
  jobRuleId       String?
  jobRule         JobRule?           @relation(fields: [jobRuleId], references: [id])
  promptVersion   String
  modelName       String
  requestPayload  Json
  responsePayload Json
  score           Int?
  decision        ScreeningDecision?
  matchedPoints   Json
  risks           Json
  summary         String?
  nextStep        Boolean?
  durationMs      Int?
  status          ScreeningStatus
  errorMessage    String?
  createdAt       DateTime           @default(now())
}

model IntegrationConfig {
  id                    String                 @id @default(cuid())
  kind                  String // mail | openai | sync_schedule
  name                  String
  accountIdentifier     String?
  provider              String?
  model                 String?
  encryptedSecret       String
  metadata              Json                   @default("{}")
  isActive              Boolean                @default(true)
  aiGatewayRouteTargets AiGatewayRouteTarget[]
  aiGatewayAttempts     AiGatewayAttempt[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model AiGatewayRoute {
  id               String                 @id @default(cuid())
  scene            String                 @unique @db.VarChar(100)
  name             String                 @db.VarChar(100)
  enabled          Boolean                @default(true)
  timeoutMs        Int                    @default(120000)
  strategy         String                 @default("priority") @db.VarChar(30)
  failureThreshold Int                    @default(3)
  cooldownMs       Int                    @default(60000)
  targets          AiGatewayRouteTarget[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model AiGatewayRouteTarget {
  id           String            @id @default(cuid())
  routeId      String
  route        AiGatewayRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  connectionId String
  connection   IntegrationConfig @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  priority     Int               @default(0)
  weight       Int               @default(100)
  enabled      Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([routeId, connectionId])
  @@index([routeId, enabled, priority])
  @@index([connectionId])
}

model AiGatewayRequest {
  id               String             @id
  scene            String             @db.VarChar(100)
  status           String             @db.VarChar(20)
  provider         String?            @db.VarChar(60)
  model            String?            @db.VarChar(120)
  latencyMs        Int
  attemptCount     Int
  fallbackUsed     Boolean            @default(false)
  promptTokens     Int                @default(0)
  completionTokens Int                @default(0)
  totalTokens      Int                @default(0)
  errorCode        String?            @db.VarChar(100)
  errorMessage     String?            @db.VarChar(500)
  attempts         AiGatewayAttempt[]
  createdAt        DateTime           @default(now())

  @@index([createdAt])
  @@index([scene, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
}

model AiGatewayAttempt {
  id           String             @id @default(cuid())
  requestId    String
  request      AiGatewayRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   IntegrationConfig? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  sequence     Int
  targetKey    String             @db.VarChar(240)
  provider     String             @db.VarChar(60)
  model        String             @db.VarChar(120)
  status       String             @db.VarChar(20)
  latencyMs    Int
  errorCode    String?            @db.VarChar(100)
  errorMessage String?            @db.VarChar(500)
  createdAt    DateTime           @default(now())

  @@unique([requestId, sequence])
  @@index([connectionId, createdAt])
  @@index([status, createdAt])
}

model GeneratedImage {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt                     String
  revisedPrompt              String   @default("")
  style                      String   @default("vivid")
  size                       String   @default("1024x1024")
  quality                    String   @default("standard")
  imageData                  String // base64 data URL (保留用于编辑操作)
  imageUrl                   String   @default("") // OSS 公网 URL，列表接口优先使用此字段
  model                      String   @default("dall-e-3")
  isFavorite                 Boolean  @default(false)
  requestId                  String?
  parentImageId              String?
  rootImageId                String?
  editInstruction            String   @default("")
  editDepth                  Int      @default(0)
  upstreamCallCount          Int      @default(0)
  upstreamRetryCount         Int      @default(0)
  upstreamErrorCount         Int      @default(0)
  inputTokens                Int      @default(0)
  inputTextTokens            Int      @default(0)
  inputImageTokens           Int      @default(0)
  outputTokens               Int      @default(0)
  totalTokens                Int      @default(0)
  estimatedCostUsd           Float    @default(0)
  cumulativeEstimatedCostUsd Float    @default(0)
  usageDetails               Json     @default("{}")
  createdAt                  DateTime @default(now())

  @@index([userId, rootImageId, createdAt])
  @@index([parentImageId])
}

/// 对话式 / 独立视频生成任务（HappyHorse i2v/t2v/r2v）。
/// 上游为 DashScope 异步接口（分钟级）：落库而非内存，支持重启后续轮询、历史库、成本累计、通知补投。
model VideoGeneration {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// MateChat 来源对话 id（对话式生成时回填，用于完成后往对话内追加消息）；独立页生成为 null
  conversationId   String?
  /// 生成模式：i2v(图生/首帧) | t2v(文生) | r2v(参考生)
  mode             String
  /// 上游模型标识，如 happyhorse-1.1-i2v
  model            String
  prompt           String   @default("")
  /// i2v 首帧 / r2v 参考图（1-9）对应的来源标识（GeneratedImage id 或原始 URL），仅留痕
  sourceImageRefs  String[] @default([])
  /// 实际提交给上游的图片 URL（i2v/r2v）
  sourceImageUrls  String[] @default([])
  resolution       String   @default("720P")
  /// 画面比例（t2v/r2v 可选，如 16:9）；i2v 由首帧决定，留空
  ratio            String   @default("")
  duration         Int      @default(5)
  watermark        Boolean  @default(true)
  seed             Int?
  /// DashScope 返回的 task_id（轮询用）
  upstreamTaskId   String?
  /// 任务状态：pending | running | succeeded | failed
  status           String   @default("pending")
  /// OSS 转存后的对象 key（列表接口用 getSignedUrl 生成访问 URL）
  videoObjectKey   String   @default("")
  /// 上游 24h 临时视频 URL（备查 / OSS 未启用时兜底）
  upstreamVideoUrl String   @default("")
  /// 计费秒数（上游 usage.duration）
  billedSeconds    Int      @default(0)
  /// 本次预估 / 实际成本（人民币元）
  costYuan         Float    @default(0)
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([upstreamTaskId])
  @@index([status])
}

/// 统一 AI 用量日志：每次 AI 调用（对话/图片/视频/…）落一条，用于用量与成本看板。
/// 与各业务表并存：业务表是权威数据源，本表是跨模态统一的用量视图（含真实 token 与成本）。
model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 模态：chat | image | video | embedding | document
  modality         String
  provider         String   @default("")
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// 人民币成本（视频真实计费）
  costYuan         Float    @default(0)
  /// 美元成本（图片估算）
  costUsd          Float    @default(0)
  /// 视频计费秒数
  seconds          Int      @default(0)
  /// token 是否为估算值（流式未返回 usage 时按内容长度估算）
  estimated        Boolean  @default(false)
  /// 来源特性标识（matechat / reverse_prompt / image_gen / video_gen 等）
  source           String   @default("")
  /// 关联业务 id（会话 / 图片 / 视频 id 等），便于追溯
  refId            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([model, createdAt])
  @@index([modality, createdAt])
}

model ImageEditMessage {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootImageId                String
  sourceImageId              String?
  resultImageId              String?
  role                       String
  content                    String
  model                      String?
  requestId                  String?
  inputTokens                Int      @default(0)
  inputTextTokens            Int      @default(0)
  inputImageTokens           Int      @default(0)
  outputTokens               Int      @default(0)
  totalTokens                Int      @default(0)
  estimatedCostUsd           Float    @default(0)
  cumulativeEstimatedCostUsd Float    @default(0)
  meta                       Json     @default("{}")
  createdAt                  DateTime @default(now())

  @@index([userId, rootImageId, createdAt])
  @@index([sourceImageId])
  @@index([resultImageId])
}

model ImagePromptChatSession {
