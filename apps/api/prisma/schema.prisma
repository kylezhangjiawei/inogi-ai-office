/// 对外资料主档。currentVersionId 指向当前确认可外发的版本；候选版本在人工确认前不会覆盖它。
model ExternalDocument {
  id               String                       @id @default(cuid())
  code             String                       @unique
  name             String
  category         String                       @default("未分类")
  ownerName        String                       @default("")
  ownerId          String?
  currentVersionId String?                      @unique
  status           String                       @default("current")
  allowSend        Boolean                      @default(false)
  versions         ExternalDocumentVersion[]
  comparisons      ExternalDocumentComparison[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([status, updatedAt])
  @@index([category])
}

/// 资料原始版本。文件存 OSS，解析文本和 OCR 证据单独固化，便于后续重新比对与审计。
model ExternalDocumentVersion {
  id                 String           @id @default(cuid())
  documentId         String
  document           ExternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version            String
  fileName           String
  mimeType           String
  fileSize           Int
  fileHash           String
  objectKey          String           @unique
  status             String           @default("pending")
  notes              String           @default("")
  extractedText      String?          @db.Text
  extractionProvider String?
  ocrRequestId       String?
  ocrConfidence      Float?
  extractionMetadata Json             @default("{}")
  /// 同一业务版本因误传而纠正文件时递增；旧文件快照保存在 replacementHistory，原 OSS 对象不删除。
  uploadRevision     Int              @default(1)
  replacementHistory Json             @default("[]")
  fileUploadedAt     DateTime         @default(now())
  uploadedById       String?
  uploadedByName     String            @default("")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@index([status])
}

/// 一次候选版与基准版的完整比对任务。differences 内含逐项人工复核状态和原文定位。
model ExternalDocumentComparison {
  id                 String           @id @default(cuid())
  jobCode            String           @unique
  documentId         String
  document           ExternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baselineVersionId  String
  candidateVersionId String           @unique
  status             String           @default("comparing")
  summary            String           @default("") @db.Text
  differences        Json             @default("[]")
  aiModel             String?
  aiProvider          String?
  aiGenerationMode    String?
  aiWarning           String?          @db.Text
  ocrProvider         String?
  ocrConfidence       Float?
  errorMessage        String?          @db.Text
  confirmedById      String?
  confirmedByName    String?
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

/// 知识库向量片段。每个 chunk 是某个原始资源（KB 文档 / 任务 / 立项 / 聊天 ...）切块后的语义索引单元。
/// 注：embedding 用 Float[]（Postgres double precision array）而非 pgvector，
///     由 Node.js 在查询时计算余弦相似度。适合 ≤10k chunks 的规模；
///     超规模再切到 pgvector 即可（schema 转换简单：JS 数组 → vector(N)）。
model KnowledgeChunk {
  id             String   @id @default(cuid())
  /// 数据源类型：'kb' | 'rd_task' | 'rd_progress_note' | 'rd_proposal' | 'rd_daily_report' | 'chat_group' | 'chat_private' | 'audit_log' | 'candidate' | 'image' | 'file_asset'
  sourceType     String
  /// 原始资源 id（KB entry id / task id / chat message id ...）
  sourceId       String
  /// 同一资源被切成多块时的序号（0-based）
  chunkIndex     Int      @default(0)
  /// chunk 原文（用于回展 + LLM 注入）
  content        String
  /// 向量（通义 text-embedding-v3/v4 默认 1024 维），存为 Postgres float8[] 数组
  embedding      Float[]
  /// 权限元数据（参与权限预过滤）：
  ///  - permission_level: number   (KB 分值制)
  ///  - visible_user_ids: string[] (私聊参与者；空数组表示对所有人开放权限层)
  ///  - visible_role_ids: string[] (按角色限制)
  ///  - department_ids: string[]   (按部门限制)
  ///  - category_id: string        (KB 分类)
  ///  - author_id / author_name: string
  ///  - title / file_name / tags 等业务字段（展示用）
  ///  - ai_classification: 'work_knowledge'|'work_chat'|'personal'|'sensitive'（聊天专用）
  metadata       Json     @default("{}")
  /// 软删除标记：用于"作者撤回"
  archived       Boolean  @default(false)
  /// 索引时使用的 embedding 模型，方便后续灰度迁移
  embeddingModel String   @default("text-embedding-v3")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
  @@index([archived])
}

/// 问题记录与 AI 定位 — 主实体。id 为业务编号（NCR-YYMM-NNN）。
/// 留痕 append-only：analyses / messages 只增不改。附件以 JSON 存 fileId 引用 FileAsset。
model Issue {
  id          String   @id
  title       String
  description String
  source      String // 'rd' | 'production'
  product     String?
  batch       String?
  station     String?
  severity    String // 'fatal' | 'major' | 'normal' | 'minor'
  defectRate  String?
  status      String   @default("pending") // pending|analyzing|adjusting|adopted|archived
  /// { kind:'analysis', causeId, solutionId } | { kind:'reuse', reusedFrom }
  adopted     Json?
  keywords    String[] @default([])
  /// { resolved, by, at, note }
  resolution  Json?
  /// Attachment[]（含 fileId / fileName / fileType / extractedText 等，展示用）
  attachments Json     @default("[]")
  createdBy   String // 创建人姓名（展示用）
  createdById String? // 创建人 user id（权限/我的）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses IssueAnalysis[]
  messages IssueMessage[]

  @@index([status])
  @@index([source])
  @@index([product])
  @@index([createdById])
}

/// 每次「初次生成 / 对话调整」存一份结构化分析快照（append-only，可对比、可采纳）。
model IssueAnalysis {
  id             String   @id @default(cuid())
  issueId        String
  issue          Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  version        Int
  /// RootCauseAnalysis：{ possibleCauses, summary, referencedCases }
  content        Json
  summary        String
  model          String
  triggerType    String // 'initial' | 'adjustment'
  basedOnVersion Int?
  createdBy      String // 'system' / 'AI' / 操作人
  isAdopted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([issueId, version])
  @@index([issueId])
}

/// 对话留痕 = 审计流水，只增不改。
model IssueMessage {
  id                String   @id @default(cuid())
  issueId           String
  issue             Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  seq               Int
  role              String // 'user' | 'assistant'
  content           String
  /// ChatUser：{ id, name, avatarUrl? }
  author            Json?
  operator          String?
  /// Attachment[]（含 fileId 引用 FileAsset）
  attachments       Json?
  analysisVersionId String?
  model             String?
  createdAt         DateTime @default(now())

  @@unique([issueId, seq])
  @@index([issueId])
}

/// 员工入职归档主档。身份证、手机号、银行卡等字段仅保存脱敏值；
/// 原始身份证号只允许在接口入参中短暂用于派生出生日期、生肖、星座、年龄和性别，不落库。
model EmployeeArchive {
  id                       String                    @id @default(cuid())
  rosterNo                 String                    @unique
  company                  String                    @default("")
  hireDate                 DateTime?
  regularizationDate       DateTime?
  settlementDate           DateTime?
  tenure                   String                    @default("")
  employmentStatus         String                    @default("")
  workLocation             String                    @default("")
  department               String                    @default("")
  title                    String                    @default("")
  employeeCode             String                    @default("")
  name                     String
  idNoMasked               String                    @default("")
  birthDate                DateTime?
  birthMonthDay            String                    @default("")
  zodiac                   String                    @default("")
  constellation            String                    @default("")
  gender                   String                    @default("")
  age                      Int                       @default(0)
  ethnicity                String                    @default("")
  maritalStatus            String                    @default("")
  phoneMasked              String                    @default("")
  bankAccountMasked        String                    @default("")
  bankBranch               String                    @default("")
  education                String                    @default("")
  school                   String                    @default("")
  major                    String                    @default("")
  hometown                 String                    @default("")
  registeredAddress        String                    @default("")
  currentAddress           String                    @default("")
  emergencyContact         String                    @default("")
  emergencyRelation        String                    @default("")
  emergencyPhoneMasked     String                    @default("")
  socialSecurityNo         String                    @default("")
  socialSecurityFirstMonth String                    @default("")
  note                     String                    @default("")
  costCenter               String                    @default("")
  /// 企业微信账号(userid)。考勤导入首次按姓名匹配成功后自动回填，之后走精确匹配。
  wecomUserId              String                    @default("")
  /// 是否参与倒挂抵扣：开启后允许 HR 单独录入倒挂扣时并累计成欠账；迟到/早退不自动计入。
  deductsInvertedHours     Boolean                   @default(false)
  archiveStatus            String                    @default("onboarding")
  archiveScore             Int                       @default(0)
  missingFields            String[]                  @default([])
  alerts                   String[]                  @default([])
  badgeConfig              Json                      @default("{}")
  source                   String                    @default("manual")
  createdById              String?
  updatedById              String?
  documents                EmployeeArchiveDocument[]
  attendanceRecords        EmployeeAttendance[]
  attendanceMonths         EmployeeAttendanceMonth[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([company])
  @@index([department])
  @@index([employmentStatus])
  @@index([archiveStatus])
  @@index([hireDate])
  @@index([employeeCode])
}

/// 员工每日考勤。人员基础信息来自 EmployeeArchive，本表只保存班次、打卡与异常结果。
model EmployeeAttendance {
  id                String          @id @default(cuid())
  employeeId        String
  employee          EmployeeArchive @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate    DateTime        @db.Date
  shiftName         String          @default("标准班")
  scheduledStart    String          @default("08:00")
  scheduledEnd      String          @default("18:00")
  checkInAt         DateTime?
  checkOutAt        DateTime?
  status            String          @default("missing")
  workMinutes       Int             @default(0)
  lateMinutes       Int             @default(0)
  earlyLeaveMinutes Int             @default(0)
  deductionMinutes  Int             @default(0)
  overtimeMinutes   Int             @default(0)
  overtimeType      String          @default("")
  /// 该日请假占多少天：1=整天，0.5=半天。非请假状态恒为 1，历史数据默认 1 即原行为。
  leaveDayFraction  Float           @default(1)
  source            String          @default("manual")
  note              String          @default("")
  createdById       String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate, status])
  @@index([employeeId, attendanceDate])
