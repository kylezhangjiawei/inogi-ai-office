  previousCompTimeBalanceHours Float           @default(0)
  previousMonthSickLeaveDays   Float           @default(0)
  entitledSickLeaveDays        Float           @default(0)
  paidSickLeaveDays            Float           @default(0)
  unpaidSickLeaveDays          Float           @default(0)
  invertedHours                Float           @default(0)
  recoveredHours               Float           @default(0)
  signature                    String          @default("")
  note                         String          @default("")
