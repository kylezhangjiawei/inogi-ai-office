model EmployeeArchiveDocument {
  id           String          @id @default(cuid())
  employeeId   String
  employee     EmployeeArchive @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  source       String          @default("")
  status       String          @default("review")
  detail       String          @default("")
  documentDate DateTime?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([employeeId, sortOrder])
}

// ── 采购管理（Proc*）────────────────────────────────────────────────────────────
// 边界：本系统自有 = 采购任务 / 物料主数据 / BOM / 报价 / 附件 / 安全库存阈值；
//       畅捷通 T+ 只读镜像 = 供应商(ProcSupplier) / 库存结存(ProcInventoryBalance) /
//       采购单(ProcPurchaseOrderRef)。下单与入库在 T+ 内完成，本系统不回写。
// 与 OrderProcessing*（销售侧订单/发票/自有库存）互不干涉，勿合并。

/// 多层 BOM 节点：自引用树。叶子节点可挂物料，中间节点为结构分组。
model ProcBomNode {
  id          String        @id @default(cuid())
  parentId    String?
  parent      ProcBomNode?  @relation("ProcBomTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProcBomNode[] @relation("ProcBomTree")
  name        String
  code        String?
  level       Int           @default(0)
  productLine String        @default("")
  materialId  String?
  material    ProcMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  qtyPer      Decimal?      @db.Decimal(14, 4)
  remark      String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([parentId, sortOrder])
  @@index([materialId])
  @@index([productLine])
}

/// 物料主数据：合并「物料 / 零件 / 存货」三概念，safeStock 阈值由本系统维护。
model ProcMaterial {
  id              String                 @id @default(cuid())
  name            String
  spec            String                 @default("")
  unit            String                 @default("")
  category        String                 @default("")
  productLine     String                 @default("")
  erpCode         String                 @default("")
  /// 畅捷通 T+ 存货编码：库存/采购单同步的锚点，未对接时为空
  tpInventoryCode String?                @unique
  isSpecial       Boolean                @default(false)
  isConsumable    Boolean                @default(false)
  safeStock       Decimal                @default(0) @db.Decimal(14, 3)
  reviewStatus    String                 @default("pending")
  reviewSource    String?
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  latestPrice     Decimal?               @db.Decimal(12, 4)
  latestSupplier  String?
  latestQuoteDate DateTime?
  /// 商品主图 OSS 对象 key；列表读取时动态生成签名 URL
  imageKey        String?                @db.VarChar(500)
  remark          String?
  metadata        Json                   @default("{}")
  bomNodes        ProcBomNode[]
  taskTreeNodes   ProcTaskTreeNode[]
  tasks           ProcTask[]
  criticalTaskLinks ProcTaskCriticalMaterial[]
  quotations      ProcQuotation[]
  supplierQuotes  ProcSupplierQuote[]
  balances        ProcInventoryBalance[]
  createdBy       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([name])
  @@index([category])
  @@index([productLine])
  @@index([reviewStatus])
}

/// 采购任务驾驶舱系统树：一级节点为分类，二级节点为物料名称。
/// 叶子可关联物料，任务通过 ProcTask.materialId 自动归入节点；节点本身不承载业务数据。
model ProcTaskTreeNode {
  id         String             @id @default(cuid())
  productId  String             @default("prod-portable-o2")
  parentId   String?
  parent     ProcTaskTreeNode?  @relation("ProcTaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   ProcTaskTreeNode[] @relation("ProcTaskTree")
  name       String
  code       String?
  spec       String?
  materialId String?
  material   ProcMaterial?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  /// 显式归属到本节点的采购任务（手工移动归类的结果）
  tasks      ProcTask[]
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([parentId, sortOrder])
  @@index([productId, parentId, sortOrder])
  @@index([materialId])
}

/// 采购任务：全流程主体。三分支——直购 / 询价(需样) / 询价(免样)。
model ProcTask {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  productId           String                 @default("prod-portable-o2")
  /// 显式归属的子系统节点。为空时回落到「按 materialId / 物料名」推导，保证存量任务不掉出树。
  /// 手工移动过归类的任务会写死在这里，不再随物料变化漂移。
  treeNodeId          String?
  treeNode            ProcTaskTreeNode?      @relation(fields: [treeNodeId], references: [id], onDelete: SetNull)
  materialId          String?
  material            ProcMaterial?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  /// 物料快照：任务创建时冻结，物料改名不影响历史任务
  materialName        String
  spec                String                 @default("")
  unit                String                 @default("")
  quantity            Decimal                @default(0) @db.Decimal(14, 3)
  method              String                 @default("inquiry")
  purchaseLink        String?
  source              String                 @default("self")
  businessLine        String                 @default("rd")
  status              String                 @default("pending_inquiry")
  priority            String                 @default("medium")
  needSample          Boolean                @default(false)
  needDate            DateTime?
  deadline            DateTime?
  expectedArrivalDate DateTime?
  paymentDate         DateTime?
  paymentStatus       String                 @default("unpaid")
  paymentNote         String?
  arrivedQty          Decimal                @default(0) @db.Decimal(14, 3)
  buyer               String                 @default("")
  buyerUserId         String?
  /// 研发流转来源：研发任务 id / 标题快照，用于研发侧回查进度
  rdTaskId            String?                @unique
  rdTaskTitle         String?
  rdContact           String?
  requester           String?
  requesterUserId     String?
  requesterDept       String?
  consumableNote      String?
  selectedQuotationId String?
  /// 已确认报价金额汇总；最终总价 = 小计 - 折扣金额
  quotationSubtotal   Decimal?               @db.Decimal(20, 4)
  quotationDiscount   Decimal?               @db.Decimal(20, 4)
  quotationTotal      Decimal?               @db.Decimal(20, 4)
  quotationCurrency   String?
  /// 业务完结：到货齐 + 结算完，与状态解耦，供统计口径使用
  businessDone        Boolean                @default(false)
  cancelReason        String?
  metadata            Json                   @default("{}")
  attachments         ProcTaskAttachment[]
  quotations          ProcQuotation[]
  purchaseOrderRefs   ProcPurchaseOrderRef[]
  /// 该任务独立关注的重点库存物料，不与其他采购任务共享配置
  criticalMaterials   ProcTaskCriticalMaterial[]
  logs                ProcTaskLog[]
  createdBy           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status, updatedAt])
  @@index([productId, status])
  @@index([businessLine, status])
  @@index([materialId])
  @@index([treeNodeId])
  @@index([buyerUserId])
  @@index([needDate])
}

/// 采购任务级重点物料配置：同一物料可被不同任务关注，并拥有不同采购周期与显示顺序。
model ProcTaskCriticalMaterial {
  id           String       @id @default(cuid())
  taskId       String
  task         ProcTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialId   String
  material     ProcMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sortOrder    Int          @default(0)
  leadTimeDays Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([taskId, materialId])
  @@index([taskId, sortOrder])
  @@index([materialId])
}

/// 任务附件：真实 OSS 文件（图纸 / 报价单 / 其他）。
model ProcTaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  task       ProcTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileKey    String?
  fileSize   Int      @default(0)
  mimeType   String?
  kind       String   @default("drawing")
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
}

/// 供应商：T+ 只读镜像（source=tplus）；未对接前允许本地录入（source=local）。
model ProcSupplier {
  id         String          @id @default(cuid())
  tpCode     String?         @unique
  name       String
  shortName  String?
  contact    String?
  phone      String?
  email      String?
  address    String?
  enabled    Boolean         @default(true)
  source     String          @default("local")
  syncedAt   DateTime?
  remark     String?
  metadata   Json            @default("{}")
  quotations ProcQuotation[]
  supplierQuotes ProcSupplierQuote[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([name])
  @@index([source])
}

/// 供应商报价库：商品(物料) × 厂家的现行报价档案，一对唯一。
/// 与 ProcQuotation（任务询价流水）语义不同：这里是长期维护的比价基准，含起订量阶梯价。
model ProcSupplierQuote {
  id            String        @id @default(cuid())
  materialId    String
  material      ProcMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      ProcSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// 厂家名快照：供应商删除后报价仍可读
  supplierName  String
  /// 厂家侧型号/品牌（同一商品各厂家命名可能不同）
  supplierModel String        @default("")
  currency      String        @default("CNY")
  taxIncluded   Boolean       @default(true)
  leadTimeDays  Int           @default(0)
  /// 阶梯报价 [{minQty, unitPrice}]，按 minQty 升序；无阶梯时单档 minQty=0
  tiers         Json          @default("[]")
  quoteDate     DateTime?
  validUntil    DateTime?
  note          String?
  /// 商品图片 OSS 对象 key（导入 .xlsx 时提取的嵌入图），读取时重签 URL
  imageKey      String?       @db.VarChar(500)
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([materialId, supplierName])
  @@index([supplierId])
}

/// 任务报价快照与历史价格流水。任务报价由供应商报价库复制生成（channel=quote-book），后续库内更新不回写任务。
model ProcQuotation {
  id           String        @id @default(cuid())
  taskId       String?
  task         ProcTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialId   String?
  material     ProcMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialName String
  supplierId   String?
  supplier     ProcSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String
  unitPrice    Decimal       @db.Decimal(12, 4)
  /// 本任务确认的采购数量与对应行金额（单价 × 数量）
  quantity     Decimal?      @db.Decimal(14, 3)
  lineTotal    Decimal?      @db.Decimal(20, 4)
  currency     String        @default("CNY")
  leadTimeDays Int           @default(0)
  minOrderQty  Decimal?      @db.Decimal(14, 3)
  quoteDate    DateTime
  validUntil   DateTime?
  channel      String        @default("manual")
  isSelected   Boolean       @default(false)
  note         String?
  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([materialId, quoteDate])
  @@index([taskId])
  @@index([supplierId])
}

/// 任务 ↔ T+ 采购单的接缝（N:N，最大包容度：一任务可拆多单，一单可含多任务行）。
/// 全部字段来自 T+ 同步，本系统只读展示，不回写 T+。
model ProcPurchaseOrderRef {
  id             String    @id @default(cuid())
  taskId         String
  task           ProcTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tpOrderNo      String
  tpOrderId      String?
  tpLineNo       String?
  supplierName   String    @default("")
  orderedQty     Decimal   @default(0) @db.Decimal(14, 3)
  receivedQty    Decimal   @default(0) @db.Decimal(14, 3)
  unitPrice      Decimal?  @db.Decimal(12, 4)
  orderDate      DateTime?
  etaDate        DateTime?
  /// T+ 审批状态：本系统不做采购审批，仅只读展示
  approvalStatus String?
  status         String?
  linkedBy       String?
  syncedAt       DateTime?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([taskId])
  @@index([tpOrderNo])
}

/// 库存结存：T+ 只读镜像。缺料预警 = stockQty < ProcMaterial.safeStock（阈值本地维护）。
model ProcInventoryBalance {
  id              String        @id @default(cuid())
  tpInventoryCode String
  materialId      String?
  material        ProcMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialName    String        @default("")
  spec            String        @default("")
  unit            String        @default("")
  warehouse       String        @default("")
  stockQty        Decimal       @default(0) @db.Decimal(14, 3)
  availableQty    Decimal       @default(0) @db.Decimal(14, 3)
  inTransitQty    Decimal       @default(0) @db.Decimal(14, 3)
  syncedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tpInventoryCode, warehouse])
  @@index([materialId])
}

/// T+ 采购订单全量镜像（行级）：与任务无关的只读快照，来自 FindVoucherList + GetVoucherDTO。
/// 与 ProcPurchaseOrderRef 分工：mirror 是「T+ 里有什么单」，ref 是「任务关联了哪张单」；
/// 匹配确认时经 linkPurchaseOrder 生成 ref，mirror 只记 matchStatus，不反向依赖任务。
model ProcPurchaseOrderMirror {
  id              String    @id @default(cuid())
  tpOrderNo       String
  tpOrderId       String?
  tpLineNo        String    @default("")
  supplierName    String    @default("")
  /// T+ 存货编码/名称：物料匹配锚点（编码 ↔ ProcMaterial.tpInventoryCode）
  inventoryCode   String    @default("")
  inventoryName   String    @default("")
  spec            String    @default("")
  unit            String    @default("")
  orderedQty      Decimal   @default(0) @db.Decimal(14, 3)
  receivedQty     Decimal   @default(0) @db.Decimal(14, 3)
  unitPrice       Decimal?  @db.Decimal(12, 4)
  orderDate       DateTime?
  etaDate         DateTime?
  approvalStatus  String?
  status          String?
  /// 按存货编码自动匹配到的物料（确定性，同步时回填）
  materialId      String?
  /// 规则/AI 建议或已确认关联的采购任务
  matchTaskId     String?
  /// unmatched | suggested | confirmed | ignored
  matchStatus     String    @default("unmatched")
  matchConfidence Decimal?  @db.Decimal(4, 3)
  matchReason     String?
  syncedAt        DateTime?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tpOrderNo, tpLineNo])
  @@index([matchStatus])
  @@index([materialId])
}

/// 采购任务留痕：状态流转与人工操作，前端时间线直接读这张表。
model ProcTaskLog {
  id          String   @id @default(cuid())
  taskId      String
  task        ProcTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind        String   @default("action")
  text        String
  fromStatus  String?
  toStatus    String?
  actor       String?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
}
