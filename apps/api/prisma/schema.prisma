generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ScreeningDecision {
  RECOMMEND
  HOLD
  REJECT
}

enum ScreeningStatus {
  COMPLETED
  SKIPPED
  FAILED
  PENDING_CONFIG
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  englishName             String                   @db.VarChar(80)
  username                String?                  @unique
  email                   String                   @unique
  passwordHash            String?
  department              String?
  status                  UserStatus               @default(ACTIVE)
  roleId                  String?
  role                    Role?                    @relation(fields: [roleId], references: [id])
  /// OSS 对象 key（如 "avatars/{userId}/{timestamp}.png"）。
  /// 每次 getCurrentUser 用 getSignedUrl 生成 30 天签名 URL 返回给前端。
  avatarObjectKey         String?                  @db.VarChar(500)
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  conversations           ChatConversation[]
  generatedImages         GeneratedImage[]
  imageEditMessages       ImageEditMessage[]
  imagePromptChatSessions ImagePromptChatSession[]
  imagePromptChatMessages ImagePromptChatMessage[]
  chatUsageEvents         ChatUsageEvent[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  category    String
  manager     String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("新对话")
  summary   String        @default("")
  pinned    Boolean       @default(false)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  reaction       String?
  // 用户消息附带的图片/文件附件，结构：[{ fileId, name, mime, size, objectKey }]
  attachments    Json?
  feedback       ChatFeedback?
  createdAt      DateTime         @default(now())
}

/// 用户对单条 AI 回答的显式反馈。reaction 仍同步保留在 ChatMessage，兼容旧客户端。
model ChatFeedback {
  id             String      @id @default(cuid())
  messageId      String      @unique
  message        ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reaction       String
  reasons        String[]    @default([])
  comment        String      @default("")
  status         String      @default("open")
  resolutionNote String      @default("")
  /// 用户最近一次提交或修改评价的时间；管理端处理状态变化不会改动它。
  submittedAt    DateTime    @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([reaction, createdAt])
  @@index([status, createdAt])
  @@index([submittedAt])
}

/// MateChat 的轻量行为埋点。对话正文不写入 metadata，只记录动作和质量指标。
model ChatUsageEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String
  conversationId String?
  messageId      String?
  model          String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
}

model ApiRequestLog {
  id           String   @id @default(cuid())
  requestId    String   @unique
  userId       String?
  method       String
  path         String
  statusCode   Int
  durationMs   Int
  ip           String?
  userAgent    String?
  errorName    String?
  errorMessage String?
  errorStack   String?
  requestMeta  Json     @default("{}")
  responseMeta Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  category    String
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PermissionCatalogItem {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String   @default("")
  groupLabel  String
  type        String   @default("page") // page | action
  routePath   String   @default("")
  enabled     Boolean  @default(true)
  /// When true the page is accessible but hidden from the sidebar navigation.
  navHidden   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupLabel, sortOrder])
  @@index([type, enabled])
}

model RuntimeState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OrderProcessingOrder {
  id               String                        @id
  customer         String
  type             String
  status           String
  shipDate         DateTime
  source           String                        @default("upload")
  generated        Boolean                       @default(false)
  invoiceExported  Boolean                       @default(false)
  originalFileName String?
  metadata         Json                          @default("{}")
  products         OrderProcessingOrderProduct[]
  invoice          OrderProcessingInvoice?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([shipDate])
}

model OrderProcessingOrderProduct {
  id         String               @id @default(cuid())
  orderId    String
  order      OrderProcessingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  category   String
  spec       String
  unit       String
  orderQty   Int
  stockQty   Int
  orderPrice Decimal              @db.Decimal(12, 2)
  sysPrice   Decimal              @db.Decimal(12, 2)
  subtotal   Decimal              @db.Decimal(14, 2)
  status     String
  remark     String
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([orderId, sku])
  @@index([sku])
  @@index([status])
}

model OrderProcessingInvoice {
  id          String               @id @default(cuid())
  orderId     String               @unique
  order       OrderProcessingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNo   String               @unique
  amount      Decimal              @db.Decimal(14, 2)
  generatedAt DateTime?
  exportedAt  DateTime?
  templateId  String?
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([generatedAt])
  @@index([exportedAt])
}

model OrderProcessingInventoryItem {
  id              String                         @id
  name            String
  category        String
  spec            String
  stock           Int
  safe            Int
  inboundPending  Int                            @default(0)
  outboundPending Int                            @default(0)
  status          String
  sortOrder       Int                            @default(0)
  movements       OrderProcessingStockMovement[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([sortOrder])
  @@index([category])
  @@index([status])
}

model OrderProcessingStockMovement {
  id             String                       @id
  itemId         String
  item           OrderProcessingInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemName       String
  type           String
  qty            Int
  operator       String
  note           String
  relatedOrderId String?
  documentNo     String?
  warehouse      String?
  supplier       String?
  businessDate   DateTime?
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now())

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([relatedOrderId])
  @@index([businessDate])
}

model OrderProcessingInvoiceTemplate {
  id          String   @id
  name        String
  source      String
  accentColor String?
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, createdAt])
}

model OrderProcessingSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model OrderProcessingInvoiceCounter {
  year      Int      @id
  nextValue Int
  updatedAt DateTime @updatedAt
}

model OrderProcessingPurchaseOrder {
  id              String                             @id @default(cuid())
  poNo            String                             @unique
  supplier        String
  supplierContact String?
  supplierPhone   String?
  supplierEmail   String?
  buyer           String
  status          String
  orderDate       DateTime
  etaDate         DateTime
  itemCount       Int                                @default(0)
  amount          Decimal                            @db.Decimal(14, 2)
  currency        String                             @default("CNY")
  warehouse       String
  owner           String
  paymentTerm     String?
  deliveryTerm    String?
  invoiceType     String?
  approvalStatus  String?
  remark          String?
  sourceFile      String?
  metadata        Json                               @default("{}")
  lines           OrderProcessingPurchaseOrderLine[]
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  @@index([status, etaDate])
  @@index([supplier])
  @@index([orderDate])
  @@index([etaDate])
}

model OrderProcessingPurchaseOrderLine {
  id              String                       @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   OrderProcessingPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku             String
  name            String
  spec            String
  unit            String
  qty             Int
  receivedQty     Int                          @default(0)
  unitPrice       Decimal                      @db.Decimal(12, 2)
  sortOrder       Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([purchaseOrderId, sortOrder])
  @@index([sku])
}

model JobRule {
  id         String               @id @default(cuid())
  name       String
  jdText     String
  enabled    Boolean              @default(true)
  candidates Candidate[]
  screenings CandidateScreening[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model Candidate {
  id                     String               @id @default(cuid())
  uniqueKey              String               @unique
  jobRuleId              String?
  jobRule                JobRule?             @relation(fields: [jobRuleId], references: [id])
  name                   String               @default("")
  email                  String               @default("")
  phone                  String               @default("")
  city                   String               @default("")
  education              String               @default("")
  status                 String               @default("")
  targetJob              String               @default("")
  targetCity             String               @default("")
  salaryExpectation      String               @default("")
  recentCompany          String               @default("")
  recentTitle            String               @default("")
  yearsExperience        String               @default("")
  rawEmailText           String
  parsedCandidateProfile Json
  receivedAt             DateTime
  sourceSubject          String               @default("")
  sourceSenderName       String               @default("")
  sourceSenderEmail      String               @default("")
  screenings             CandidateScreening[]
  ingestionLogs          EmailIngestionLog[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model CandidateScreening {
  id              String             @id @default(cuid())
  candidateId     String
  candidate       Candidate          @relation(fields: [candidateId], references: [id])
  jobRuleId       String?
  jobRule         JobRule?           @relation(fields: [jobRuleId], references: [id])
  promptVersion   String
  modelName       String
  requestPayload  Json
  responsePayload Json
  score           Int?
  decision        ScreeningDecision?
  matchedPoints   Json
  risks           Json
  summary         String?
  nextStep        Boolean?
  durationMs      Int?
  status          ScreeningStatus
  errorMessage    String?
  createdAt       DateTime           @default(now())
}

model IntegrationConfig {
  id                String   @id @default(cuid())
  kind              String // mail | openai | sync_schedule
  name              String
  accountIdentifier String?
  provider          String?
  model             String?
  encryptedSecret   String
  metadata          Json     @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GeneratedImage {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt                     String
  revisedPrompt              String   @default("")
  style                      String   @default("vivid")
  size                       String   @default("1024x1024")
  quality                    String   @default("standard")
  imageData                  String // base64 data URL (保留用于编辑操作)
  imageUrl                   String   @default("") // OSS 公网 URL，列表接口优先使用此字段
  model                      String   @default("dall-e-3")
  isFavorite                 Boolean  @default(false)
  requestId                  String?
  parentImageId              String?
  rootImageId                String?
  editInstruction            String   @default("")
  editDepth                  Int      @default(0)
  upstreamCallCount          Int      @default(0)
  upstreamRetryCount         Int      @default(0)
  upstreamErrorCount         Int      @default(0)
  inputTokens                Int      @default(0)
  inputTextTokens            Int      @default(0)
  inputImageTokens           Int      @default(0)
  outputTokens               Int      @default(0)
  totalTokens                Int      @default(0)
  estimatedCostUsd           Float    @default(0)
  cumulativeEstimatedCostUsd Float    @default(0)
  usageDetails               Json     @default("{}")
  createdAt                  DateTime @default(now())

  @@index([userId, rootImageId, createdAt])
  @@index([parentImageId])
}

model ImageEditMessage {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootImageId                String
  sourceImageId              String?
  resultImageId              String?
  role                       String
  content                    String
  model                      String?
  requestId                  String?
  inputTokens                Int      @default(0)
  inputTextTokens            Int      @default(0)
  inputImageTokens           Int      @default(0)
  outputTokens               Int      @default(0)
  totalTokens                Int      @default(0)
  estimatedCostUsd           Float    @default(0)
  cumulativeEstimatedCostUsd Float    @default(0)
  meta                       Json     @default("{}")
  createdAt                  DateTime @default(now())

  @@index([userId, rootImageId, createdAt])
  @@index([sourceImageId])
  @@index([resultImageId])
}

model ImagePromptChatSession {
  id            String                   @id @default(cuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String                   @default("新提示词对话")
  sourcePrompt  String                   @default("")
  currentPrompt String                   @default("")
  model         String?
  messages      ImagePromptChatMessage[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([userId, updatedAt])
}

model ImagePromptChatMessage {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         ImagePromptChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role            String
  content         String
  optimizedPrompt String                 @default("")
  model           String?
  requestId       String?
  createdAt       DateTime               @default(now())

  @@index([userId, sessionId, createdAt])
}

model EmailIngestionLog {
  id           String     @id @default(cuid())
  mailbox      String
  imapUid      Int?
  messageId    String?
  uniqueKey    String     @unique
  subject      String
  senderName   String
  senderEmail  String
  receivedAt   DateTime
  status       String
  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id])
  errorMessage String?
  createdAt    DateTime   @default(now())
}

model FileAsset {
  id           String    @id @default(cuid())
  bucket       String
  objectKey    String    @unique
  fileName     String
  mimeType     String
  fileSize     Int
  fileHash     String?
  businessType String
  businessId   String?
  uploadedBy   String?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([businessType, businessId])
  @@index([uploadedBy])
}

/// 知识库向量片段。每个 chunk 是某个原始资源（KB 文档 / 任务 / 立项 / 聊天 ...）切块后的语义索引单元。
/// 注：embedding 用 Float[]（Postgres double precision array）而非 pgvector，
///     由 Node.js 在查询时计算余弦相似度。适合 ≤10k chunks 的规模；
///     超规模再切到 pgvector 即可（schema 转换简单：JS 数组 → vector(N)）。
model KnowledgeChunk {
  id             String   @id @default(cuid())
  /// 数据源类型：'kb' | 'rd_task' | 'rd_progress_note' | 'rd_proposal' | 'rd_daily_report' | 'chat_group' | 'chat_private' | 'audit_log' | 'candidate' | 'image' | 'file_asset'
  sourceType     String
  /// 原始资源 id（KB entry id / task id / chat message id ...）
  sourceId       String
  /// 同一资源被切成多块时的序号（0-based）
  chunkIndex     Int      @default(0)
  /// chunk 原文（用于回展 + LLM 注入）
  content        String
  /// 向量（通义 text-embedding-v3/v4 默认 1024 维），存为 Postgres float8[] 数组
  embedding      Float[]
  /// 权限元数据（参与权限预过滤）：
  ///  - permission_level: number   (KB 分值制)
  ///  - visible_user_ids: string[] (私聊参与者；空数组表示对所有人开放权限层)
  ///  - visible_role_ids: string[] (按角色限制)
  ///  - department_ids: string[]   (按部门限制)
  ///  - category_id: string        (KB 分类)
  ///  - author_id / author_name: string
  ///  - title / file_name / tags 等业务字段（展示用）
  ///  - ai_classification: 'work_knowledge'|'work_chat'|'personal'|'sensitive'（聊天专用）
  metadata       Json     @default("{}")
  /// 软删除标记：用于"作者撤回"
  archived       Boolean  @default(false)
  /// 索引时使用的 embedding 模型，方便后续灰度迁移
  embeddingModel String   @default("text-embedding-v3")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
  @@index([archived])
}

/// 问题记录与 AI 定位 — 主实体。id 为业务编号（NCR-YYMM-NNN）。
/// 留痕 append-only：analyses / messages 只增不改。附件以 JSON 存 fileId 引用 FileAsset。
model Issue {
  id          String   @id
  title       String
  description String
  source      String // 'rd' | 'production'
  product     String?
  batch       String?
  station     String?
  severity    String // 'fatal' | 'major' | 'normal' | 'minor'
  defectRate  String?
  status      String   @default("pending") // pending|analyzing|adjusting|adopted|archived
  /// { kind:'analysis', causeId, solutionId } | { kind:'reuse', reusedFrom }
  adopted     Json?
  keywords    String[] @default([])
  /// { resolved, by, at, note }
  resolution  Json?
  /// Attachment[]（含 fileId / fileName / fileType / extractedText 等，展示用）
  attachments Json     @default("[]")
  createdBy   String // 创建人姓名（展示用）
  createdById String? // 创建人 user id（权限/我的）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses IssueAnalysis[]
  messages IssueMessage[]

  @@index([status])
  @@index([source])
  @@index([product])
  @@index([createdById])
}

/// 每次「初次生成 / 对话调整」存一份结构化分析快照（append-only，可对比、可采纳）。
model IssueAnalysis {
  id             String   @id @default(cuid())
  issueId        String
  issue          Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  version        Int
  /// RootCauseAnalysis：{ possibleCauses, summary, referencedCases }
  content        Json
  summary        String
  model          String
  triggerType    String // 'initial' | 'adjustment'
  basedOnVersion Int?
  createdBy      String // 'system' / 'AI' / 操作人
  isAdopted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([issueId, version])
  @@index([issueId])
}

/// 对话留痕 = 审计流水，只增不改。
model IssueMessage {
  id                String   @id @default(cuid())
  issueId           String
  issue             Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  seq               Int
  role              String // 'user' | 'assistant'
  content           String
  /// ChatUser：{ id, name, avatarUrl? }
  author            Json?
  operator          String?
  /// Attachment[]（含 fileId 引用 FileAsset）
  attachments       Json?
  analysisVersionId String?
  model             String?
  createdAt         DateTime @default(now())

  @@unique([issueId, seq])
  @@index([issueId])
}

/// 员工入职归档主档。身份证、手机号、银行卡等字段仅保存脱敏值；
/// 原始身份证号只允许在接口入参中短暂用于派生出生日期、生肖、星座、年龄和性别，不落库。
model EmployeeArchive {
  id                       String                    @id @default(cuid())
  rosterNo                 String                    @unique
  company                  String                    @default("")
  hireDate                 DateTime?
  tenure                   String                    @default("")
  employmentStatus         String                    @default("")
  workLocation             String                    @default("")
  department               String                    @default("")
  title                    String                    @default("")
  name                     String
  idNoMasked               String                    @default("")
  birthDate                DateTime?
  birthMonthDay            String                    @default("")
  zodiac                   String                    @default("")
  constellation            String                    @default("")
  gender                   String                    @default("")
  age                      Int                       @default(0)
  ethnicity                String                    @default("")
  maritalStatus            String                    @default("")
  phoneMasked              String                    @default("")
  bankAccountMasked        String                    @default("")
  bankBranch               String                    @default("")
  education                String                    @default("")
  school                   String                    @default("")
  major                    String                    @default("")
  hometown                 String                    @default("")
  registeredAddress        String                    @default("")
  currentAddress           String                    @default("")
  emergencyContact         String                    @default("")
  emergencyRelation        String                    @default("")
  emergencyPhoneMasked     String                    @default("")
  socialSecurityNo         String                    @default("")
  socialSecurityFirstMonth String                    @default("")
  note                     String                    @default("")
  costCenter               String                    @default("")
  archiveStatus            String                    @default("onboarding")
  archiveScore             Int                       @default(0)
  missingFields            String[]                  @default([])
  alerts                   String[]                  @default([])
  badgeConfig              Json                      @default("{}")
  source                   String                    @default("manual")
  createdById              String?
  updatedById              String?
  documents                EmployeeArchiveDocument[]
  attendanceRecords        EmployeeAttendance[]
  attendanceMonths         EmployeeAttendanceMonth[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([company])
  @@index([department])
  @@index([employmentStatus])
  @@index([archiveStatus])
  @@index([hireDate])
}

/// 员工每日考勤。人员基础信息来自 EmployeeArchive，本表只保存班次、打卡与异常结果。
model EmployeeAttendance {
  id                String          @id @default(cuid())
  employeeId        String
  employee          EmployeeArchive @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate    DateTime        @db.Date
  shiftName         String          @default("标准班")
  scheduledStart    String          @default("08:00")
  scheduledEnd      String          @default("18:00")
  checkInAt         DateTime?
  checkOutAt        DateTime?
  status            String          @default("missing")
  workMinutes       Int             @default(0)
  lateMinutes       Int             @default(0)
  earlyLeaveMinutes Int             @default(0)
  deductionMinutes  Int             @default(0)
  overtimeMinutes   Int             @default(0)
  overtimeType      String          @default("")
  source            String          @default("manual")
  note              String          @default("")
  createdById       String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate, status])
  @@index([employeeId, attendanceDate])
}

/// 月度考勤结余与审核字段。此类数据无法从每日打卡自动推导，按人员和月份单独维护。
model EmployeeAttendanceMonth {
  id                           String          @id @default(cuid())
  employeeId                   String
  employee                     EmployeeArchive @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year                         Int
  month                        Int
  previousOvertimeBalance      Float           @default(0)
  previousCompTimeBalanceHours Float           @default(0)
  previousMonthSickLeaveDays   Float           @default(0)
  entitledSickLeaveDays        Float           @default(0)
  paidSickLeaveDays            Float           @default(0)
  unpaidSickLeaveDays          Float           @default(0)
  invertedHours                Float           @default(0)
  recoveredHours               Float           @default(0)
  signature                    String          @default("")
  note                         String          @default("")
  createdById                  String?
  updatedById                  String?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
}

model EmployeeArchiveDocument {
  id           String          @id @default(cuid())
  employeeId   String
  employee     EmployeeArchive @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  source       String          @default("")
  status       String          @default("review")
  detail       String          @default("")
  documentDate DateTime?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([employeeId, sortOrder])
}
