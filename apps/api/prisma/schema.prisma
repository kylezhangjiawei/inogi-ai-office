generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ScreeningDecision {
  RECOMMEND
  HOLD
  REJECT
}

enum ScreeningStatus {
  COMPLETED
  SKIPPED
  FAILED
  PENDING_CONFIG
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id            String             @id @default(cuid())
  name          String
  username      String?            @unique
  email         String             @unique
  passwordHash  String?
  department    String?
  status        UserStatus         @default(ACTIVE)
  roleId        String?
  role          Role?              @relation(fields: [roleId], references: [id])
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  conversations   ChatConversation[]
  generatedImages GeneratedImage[]
  imageEditMessages ImageEditMessage[]
  imagePromptChatSessions ImagePromptChatSession[]
  imagePromptChatMessages ImagePromptChatMessage[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  category    String
  manager     String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("新对话")
  summary   String        @default("")
  pinned    Boolean       @default(false)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  reaction       String?
  createdAt      DateTime         @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
}

model ApiRequestLog {
  id           String   @id @default(cuid())
  requestId    String   @unique
  userId       String?
  method       String
  path         String
  statusCode   Int
  durationMs   Int
  ip           String?
  userAgent    String?
  errorName    String?
  errorMessage String?
  errorStack   String?
  requestMeta  Json     @default("{}")
  responseMeta Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  category    String
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PermissionCatalogItem {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String   @default("")
  groupLabel  String
  type        String   @default("page") // page | action
  routePath   String   @default("")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupLabel, sortOrder])
  @@index([type, enabled])
}

model RuntimeState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model JobRule {
  id         String                @id @default(cuid())
  name       String
  jdText     String
  enabled    Boolean               @default(true)
  candidates Candidate[]
  screenings CandidateScreening[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model Candidate {
  id                     String               @id @default(cuid())
  uniqueKey              String               @unique
  jobRuleId              String?
  jobRule                JobRule?             @relation(fields: [jobRuleId], references: [id])
  name                   String               @default("")
  email                  String               @default("")
  phone                  String               @default("")
  city                   String               @default("")
  education              String               @default("")
  status                 String               @default("")
  targetJob              String               @default("")
  targetCity             String               @default("")
  salaryExpectation      String               @default("")
  recentCompany          String               @default("")
  recentTitle            String               @default("")
  yearsExperience        String               @default("")
  rawEmailText           String
  parsedCandidateProfile Json
  receivedAt             DateTime
  sourceSubject          String               @default("")
  sourceSenderName       String               @default("")
  sourceSenderEmail      String               @default("")
  screenings             CandidateScreening[]
  ingestionLogs          EmailIngestionLog[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model CandidateScreening {
  id              String             @id @default(cuid())
  candidateId     String
  candidate       Candidate          @relation(fields: [candidateId], references: [id])
  jobRuleId       String?
  jobRule         JobRule?           @relation(fields: [jobRuleId], references: [id])
  promptVersion   String
  modelName       String
  requestPayload  Json
  responsePayload Json
  score           Int?
  decision        ScreeningDecision?
  matchedPoints   Json
  risks           Json
  summary         String?
  nextStep        Boolean?
  durationMs      Int?
  status          ScreeningStatus
  errorMessage    String?
  createdAt       DateTime           @default(now())
}

model IntegrationConfig {
  id                String   @id @default(cuid())
  kind              String   // mail | openai | sync_schedule
  name              String
  accountIdentifier String?
  provider          String?
  model             String?
  encryptedSecret   String
  metadata          Json     @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GeneratedImage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt        String
  revisedPrompt String   @default("")
  style         String   @default("vivid")
  size          String   @default("1024x1024")
  quality       String   @default("standard")
  imageData     String   // base64 data URL
  model         String   @default("dall-e-3")
  isFavorite    Boolean  @default(false)
  requestId          String?
  parentImageId      String?
  rootImageId        String?
  editInstruction    String   @default("")
  editDepth          Int      @default(0)
  upstreamCallCount  Int      @default(0)
  upstreamRetryCount Int      @default(0)
  upstreamErrorCount Int      @default(0)
  inputTokens        Int      @default(0)
  inputTextTokens    Int      @default(0)
  inputImageTokens   Int      @default(0)
  outputTokens       Int      @default(0)
  totalTokens        Int      @default(0)
  estimatedCostUsd   Float    @default(0)
  cumulativeEstimatedCostUsd Float @default(0)
  usageDetails       Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([userId, rootImageId, createdAt])
  @@index([parentImageId])
}

model ImageEditMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootImageId   String
  sourceImageId String?
  resultImageId String?
  role          String
  content       String
  model         String?
  requestId     String?
  inputTokens     Int   @default(0)
  inputTextTokens Int   @default(0)
  inputImageTokens Int  @default(0)
  outputTokens    Int   @default(0)
  totalTokens     Int   @default(0)
  estimatedCostUsd Float @default(0)
  cumulativeEstimatedCostUsd Float @default(0)
  meta          Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([userId, rootImageId, createdAt])
  @@index([sourceImageId])
  @@index([resultImageId])
}

model ImagePromptChatSession {
  id            String                   @id @default(cuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String                   @default("新提示词对话")
  sourcePrompt  String                   @default("")
  currentPrompt String                   @default("")
  model         String?
  messages      ImagePromptChatMessage[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([userId, updatedAt])
}

model ImagePromptChatMessage {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         ImagePromptChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role            String
  content         String
  optimizedPrompt String                 @default("")
  model           String?
  requestId       String?
  createdAt       DateTime               @default(now())

  @@index([userId, sessionId, createdAt])
}

model EmailIngestionLog {
  id           String    @id @default(cuid())
  mailbox      String
  imapUid      Int?
  messageId    String?
  uniqueKey    String    @unique
  subject      String
  senderName   String
  senderEmail  String
  receivedAt   DateTime
  status       String
  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id])
  errorMessage String?
  createdAt    DateTime  @default(now())
}
