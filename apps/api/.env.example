PORT=3000
DATABASE_URL="postgresql://inogi_admin:replace-with-a-strong-password@127.0.0.1:5432/inogi_ai_office?schema=public"
CORS_ORIGIN="http://localhost:5173"
# Connection-pool ceiling shown on the ops-center dashboard. Display only; defaults to 80.
DATABASE_POOL_LIMIT=80

# REQUIRED. Auth is fail-closed: the API refuses to boot in production without it
# (src/main.ts), and the auth module resolves it via getOrThrow. Use a strong random
# value, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Key used to encrypt integration credentials persisted in the database. If omitted it
# silently falls back to a hardcoded constant in src/modules/security/secure-config.service.ts,
# which means the stored ciphertext is protected by a publicly known key. Always set this
# in production.
CONFIG_ENCRYPTION_SECRET=

# Optional T+ compatibility override. Keep the default unless the tenant's OpenAPI
# exposes the inventory master query under a different T+ v2 path.
TPLUS_MATERIAL_MASTER_PATH=/tplus/api/v2/inventory/Query

MAIL_IMAP_HOST=imap.exmail.qq.com
MAIL_IMAP_PORT=993
MAIL_USERNAME=hr@example.com
MAIL_PASSWORD=replace-me
MAIL_FOLDER=INBOX
MAIL_SOURCE_KEYWORDS=zhaopin,zhaopinmail.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
# Override the OpenAI-compatible endpoint (self-hosted gateway, Azure, proxy…).
# Leave empty to use the official api.openai.com base URL.
OPENAI_BASE_URL=
# Qwen structured JSON output budget for external-document comparison summaries.
EXTERNAL_DOCS_QWEN_JSON_MAX_TOKENS=16000

# Qwen / DashScope. DASHSCOPE_API_KEY wins; QWEN_API_KEY is the legacy alias kept as a
# fallback. Base URL defaults to the DashScope OpenAI-compatible endpoint below.
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MateChat ReAct image quota: images one user may generate per day (Asia/Shanghai).
# Generating an image inside a conversation needs no confirmation and costs real money,
# so this is the daily ceiling. Optional; defaults to 20. Over the limit the image tools
# are simply not offered to the model that day.
MATECHAT_DAILY_IMAGE_LIMIT=20

# Issue AI module budgets. All optional; the defaults below match issue.constants.ts.
ISSUE_AI_TIMEOUT_MS=240000
ISSUE_AI_MAX_TOKENS=2000
# How long a finished AI task stays retrievable before it is evicted.
ISSUE_TASK_TTL_MS=1800000

# Parallel resume-screening AI calls. Raise carefully: it multiplies upstream QPS.
AI_SCREENING_CONCURRENCY=2

# Outbound proxy for upstream AI/OSS calls. Only needed on networks without direct egress.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Ops-center observability badges. Presence-only flags: setting any of these flips the
# corresponding card on the ops dashboard from "待接入" to "已接入". No credentials are
# read from them, so leaving them empty only affects that display.
ALIYUN_SLS_PROJECT=
ALIYUN_RDS_INSTANCE_ID=
ARMS_APP_NAME=

SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_ENGLISH_NAME="System Administrator"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE_NAME="Super Admin"
SEED_ADMIN_ROLE_DESCRIPTION="Full system access."

# Expense module - Tencent Cloud OCR
TENCENTCLOUD_OCR_ENABLED=true
TENCENTCLOUD_SECRET_ID=your-tencentcloud-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencentcloud-secret-key
TENCENTCLOUD_OCR_REGION=ap-guangzhou
TENCENTCLOUD_OCR_ENDPOINT=ocr.tencentcloudapi.com
TENCENTCLOUD_OCR_INVOICE_ACTION=RecognizeGeneralInvoice

# Expense module - WeCom approval
WECOM_EXPENSE_ENABLED=true
WECOM_CORP_ID=
WECOM_EXPENSE_AGENT_ID=
WECOM_EXPENSE_SECRET=
WECOM_EXPENSE_APPROVAL_TEMPLATE_ID=
WECOM_EXPENSE_CREATOR_USERID=
WECOM_EXPENSE_CALLBACK_TOKEN=
WECOM_EXPENSE_CALLBACK_AES_KEY=

# Expense module - WeCom approval template control IDs
WECOM_EXPENSE_CONTROL_TITLE=
WECOM_EXPENSE_CONTROL_AMOUNT=
WECOM_EXPENSE_CONTROL_REASON=
WECOM_EXPENSE_CONTROL_INVOICE_COUNT=
WECOM_EXPENSE_CONTROL_PROJECT=

# Expense module - original invoice/voucher file storage
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_BASE_PREFIX=prod
# Optional read-only CDN acceleration. Upload PUT URLs continue using OSS_PUBLIC_ENDPOINT.
# Configure the accelerated domain with Alibaba Cloud CDN URL signing Type A and set the same
# primary/secondary key here. Keep the key server-only; never expose it through VITE_* variables.
OSS_CDN_DOMAIN=
OSS_CDN_AUTH_TYPE=A
OSS_CDN_AUTH_KEY=
# Must exactly match the TTL configured in the CDN console (recommended: 7 days).
OSS_CDN_AUTH_TTL_SECONDS=604800
# Emit the same signed URL for one day so browser disk cache survives rerenders/navigation.
OSS_CDN_URL_STABLE_SECONDS=86400
# Separate capability-token secret for API preview fallback. Falls back to JWT_SECRET if omitted.
OSS_PREVIEW_SECRET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Expense module - reimbursement email notifications
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI gateway - failover, rate-limit backoff and telemetry retention.
# All optional; the defaults shown here apply when a variable is unset.
# Consecutive failures on one connection before its circuit opens for a scene.
AI_GATEWAY_FAILURE_THRESHOLD=3
# How long an open circuit stays open before the next request may probe it.
AI_GATEWAY_CIRCUIT_COOLDOWN_MS=60000
# Retries against the SAME connection when it answers 429. Set 0 to fail over immediately.
AI_GATEWAY_MAX_RETRIES_PER_TARGET=1
# Base delay for exponential backoff (jittered ±25%) when no Retry-After header is returned.
AI_GATEWAY_RETRY_BASE_DELAY_MS=500
# Upper bound on a single wait. A longer Retry-After makes the gateway fail over instead of blocking.
AI_GATEWAY_MAX_RETRY_DELAY_MS=10000
# Days of AiGatewayRequest/AiGatewayAttempt telemetry kept by the 04:15 Asia/Shanghai purge job.
AI_GATEWAY_RETENTION_DAYS=90


# 操作留痕保留天数（默认 730 = 24 个月）。0 表示永不清理；低于 90 会被按 90 处理。
# 每天 03:20 由 AuditRetentionCron 分批删除超期记录。
AUDIT_LOG_RETENTION_DAYS=730
