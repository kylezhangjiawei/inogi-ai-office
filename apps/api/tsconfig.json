{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    // 现有代码已全部满足，逐项开启防止回退。尚未开启的是 noImplicitThis(1 处)
    // 和 noImplicitAny(18 处)，修完后可整体换成 "strict": true。
    "strictFunctionTypes": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "paths": {
      "src/*": [
        "src/*"
      ]
    }
  },
  // test/*.spec.ts 只进类型检查，不进构建产物（tsconfig.build.json 把它排除了）。
  // 不含 .mts：那几个跑在 Node 原生类型剥离下，是 ESM 语义，与这里的 commonjs 配置不兼容，
  // 且它们从来就没被类型检查过（原生剥离不做检查）。
  // 部署时的 API 测试跑在 ts-node 的 transpile-only 下（快 3 倍），
  // 类型检查改由这里的单次 tsc 统一覆盖，比 50 个测试进程各查一遍便宜得多。
  "include": [
    "src/**/*",
    "prisma/**/*",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
